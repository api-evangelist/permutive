{
  "openapi": "3.0.1",
  "info": {
    "title": "Cohorts API",
    "version": "1",
    "description": "Programmatically view and maintain cohort definitions"
  },
  "servers": [
    {
      "url": "https://api.permutive.app/cohorts-api"
