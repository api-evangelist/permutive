{
  "opencollection": "1.0.0",
  "info": {
    "name": "Identity API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "v2.0",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a user ID",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.permutive.app/v2.0/users",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint generates a new user ID that can be used to identify a user within Permutive.\n\n When you're not using an SDK, and you're interacting with this endpoint directly, it is your responsibility to store a user's ID. This endpoint responds with a Permtive user ID that can be used to identify a user within Permutive, to be stored by the client."
        },
        {
          "info": {
            "name": "Identify a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.permutive.app/v2.0/identify",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Associate one or more identities with a Permutive user, allowing you to identify users in multiple ways."
        },
        {
          "info": {
            "name": "Retrieve user identities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.permutive.app/v2.0/users/:userId/aliases",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The Permutive user ID of the user to retrieve identities for."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves all identities available for a given user."
        }
      ]
    }
  ],
  "bundled": true
}