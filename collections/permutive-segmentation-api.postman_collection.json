        {
          "id": "254be040-b552-4f8a-84ff-b41467ad9ddb",
          "name": "Segment user based on provided events and state only",
          "request": {
            "name": "Segment user based on provided events and state only",
            "description": {
              "content": "This endpoint accepts a list of events for a given user and optionally some pre-existing state for the user. It uses these to determine the full list of cohorts of which they are a member, and returns these along with the updated state for the user. State is not persisted, so will not be used in the next request unless it is passed back in as part of that request.\n\nIt is likely that this endpoint is more performant than the stateful segmentation endpoint, since it does not need to read state for the user from a database. It is also useful for testing purposes.\n\nEvents provided to this endpoint are published to the Permutive Events API, meaning that they will be reflected in other areas of Permutive, for example Insights.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ccs",
                "v1",
                "segmentation",
                "stateless"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "synchronous-validation",
                  "value": "false",
                  "description": "Validate provided event(s) against their schema before proceeding with segmentation.\n\nBy default validation is performed asynchronously after segmentation has been performed and the response has been returned. This can make it difficult to debug issues with invalid events.\n\nIt is recommended to use this option only during development and debugging, as validation can be expensive and slow."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
