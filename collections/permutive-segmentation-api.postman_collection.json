          "id": "4e4094fa-f1ef-4249-98f5-34be9c4da916",
          "name": "Segment user based on provided events and pre-existing state",
          "request": {
            "name": "Segment user based on provided events and pre-existing state",
            "description": {
              "content": "This endpoint accepts a list of events for a given user and combines them with any pre-existing state for the user to determine the full list of cohorts of which they are a member. State is also persisted, to be applied to subsequent requests for the same user.\n\nEvents provided to this endpoint are published to the Permutive Events API, meaning that they will be reflected in other areas of Permutive, for example Insights.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ccs",
                "v1",
                "segmentation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "activations",
                  "value": "false",
                  "description": "Return a list of activated cohorts in the response"
                },
                {
                  "disabled": false,
                  "key": "synchronous-validation",
                  "value": "false",
                  "description": "Validate provided event(s) against their schema before proceeding with segmentation.\n\nBy default validation is performed asynchronously after segmentation has been performed and the response has been returned. This can make it difficult to debug issues with invalid events.\n\nIt is recommended to use this option only during development and debugging, as validation can be expensive and slow."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
